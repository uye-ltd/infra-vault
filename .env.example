# Copy to .env and fill in values. Never commit .env.

# Required: Vault unseal key from `vault operator init` output
VAULT_UNSEAL_KEY=

# Optional: public URL when a domain is configured (used as Vault's self-reported api_addr)
# VAULT_API_ADDR=https://vault.yourdomain.com

# Optional: override the vault-unseal image (defaults to GHCR)
# VAULT_UNSEAL_IMAGE=ghcr.io/uye-ltd/vault-unseal:latest
